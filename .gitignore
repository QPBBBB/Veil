# Unity-generated caches and local editor state
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Oo]bj/
/UnityProject/[Ll]ogs/
/UnityProject/[Uu]ser[Ss]ettings/
/UnityProject/[Mm]emoryCaptures/
/UnityProject/[Rr]ecordings/

# Local build output
/UnityProject/[Bb]uild/
/UnityProject/[Bb]uilds/

# Generated IDE projects and per-user IDE state
/UnityProject/.vs/
/UnityProject/.idea/
/UnityProject/*.csproj
/UnityProject/*.sln
/UnityProject/*.slnx
/UnityProject/*.suo
/UnityProject/*.user
/UnityProject/*.userprefs
/UnityProject/*.pidb
/UnityProject/*.booproj
/UnityProject/*.svd
/UnityProject/*.opendb
/UnityProject/*.VC.db

# Unity crash reports and generated diagnostics
/UnityProject/sysinfo.txt
/UnityProject/mono_crash.*

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Python bytecode and tool caches (including Tools/Python39)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# FBX SDK: retain headers, license/readme, and x64 Release shared libraries
/Tools/SDK/FBX/*
!/Tools/SDK/FBX/include/
!/Tools/SDK/FBX/License.rtf
!/Tools/SDK/FBX/readme.txt
!/Tools/SDK/FBX/lib/
/Tools/SDK/FBX/lib/*
!/Tools/SDK/FBX/lib/x64/
/Tools/SDK/FBX/lib/x64/*
!/Tools/SDK/FBX/lib/x64/release/
/Tools/SDK/FBX/lib/x64/release/*
!/Tools/SDK/FBX/lib/x64/release/libfbxsdk.dll
!/Tools/SDK/FBX/lib/x64/release/libfbxsdk.lib

# External content is mounted locally; keep Content.meta in the project.
/Content/
/UnityProject/Assets/Content

# Keep other Assets (including .meta), Packages, and ProjectSettings tracked.

# UnityProject generated files
/UnityProject/.utmp/
/UnityProject/*_BackUpThisFolder_ButDontShipItWithYourGame/
/UnityProject/*_BurstDebugInformation_DoNotShip/
/.vs/
/.idea/
/UnityProject/*.unityproj
/UnityProject/*.DotSettings.user
/UnityProject/ExportedObj/
/UnityProject/consulo/
/UnityProject/*.log
